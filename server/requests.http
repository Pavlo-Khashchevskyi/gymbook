@token = paste-invite-token-here

### valid invite
POST http://localhost:3000/api/auth/register
Content-Type: application/json

{
  "token": "{{token}}",
  "email": "pablo@example.com",
  "password": "password123",
  "firstName": "Pablo",
  "lastName": "Test"
}

### invalid invite
POST http://localhost:3000/api/auth/register
Content-Type: application/json

{
  "token": "00000000-0000-4000-8000-000000000000",
  "email": "pablo@example.com",
  "password": "password123",
  "firstName": "Pablo",
  "lastName": "Test"
}

### missing password
POST http://localhost:3000/api/auth/register
Content-Type: application/json

{
  "token": "{{token}}",
  "email": "pablo@example.com",
  "firstName": "Pablo",
  "lastName": "Test"
}

### email already in use → expect 409
POST http://localhost:3000/api/auth/register
Content-Type: application/json

{
  "token": "{{token}}",
  "email": "trainer1@example.com",
  "password": "password123",
  "firstName": "Pablo",
  "lastName": "Test"
}

### register new trainer → expect 201 (send twice: 2nd → 400 'Invite already used')
POST http://localhost:3000/api/auth/register
Content-Type: application/json

{
  "token": "{{token}}",
  "email": "trainer1@example.com",
  "password": "password123",
  "firstName": "Ivan",
  "lastName": "Trainer"
}

### login
# @name login
POST http://localhost:3000/api/auth/login
Content-Type: application/json

{
  "email": "trainer1@example.com",
  "password": "password123"
}

###
@authToken = {{login.response.body.token}}

### me — no token (expect 401)
GET http://localhost:3000/api/auth/me

### me — valid token (expect 200)
GET http://localhost:3000/api/auth/me
Authorization: Bearer {{authToken}}

### me — broken token (expect 401)
GET http://localhost:3000/api/auth/me
Authorization: Bearer abc.def.ghi

### me — wrong scheme (expect 401)
GET http://localhost:3000/api/auth/me
Authorization: Basic {{authToken}}

### login as client
# @name loginClient
POST http://localhost:3000/api/auth/login
Content-Type: application/json

{
  "email": "client1@example.com",
  "password": "password123"
}

###
@clientToken = {{loginClient.response.body.token}}

### invites — no token (expect 401)
GET http://localhost:3000/api/invites

### invites — trainer (expect 200)
GET http://localhost:3000/api/invites
Authorization: Bearer {{authToken}}

### invites — client (expect 403)
GET http://localhost:3000/api/invites
Authorization: Bearer {{clientToken}}

### invites — trainer creates client invite (expect 201)
# @name createInvite
POST http://localhost:3000/api/invites
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "role": "client"
}

### invites — trainer creates trainer invite (expect 403)
POST http://localhost:3000/api/invites
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "role": "trainer"
}

### invites — invalid role (expect 400)
POST http://localhost:3000/api/invites
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "role": "admin"
}

### invites — create without token (expect 401)
POST http://localhost:3000/api/invites
Content-Type: application/json

{
  "role": "client"
}

### register client with the new invite (expect 201)
POST http://localhost:3000/api/auth/register
Content-Type: application/json

{
  "token": "{{createInvite.response.body.token}}",
  "email": "client1@example.com",
  "password": "password123",
  "firstName": "Anna",
  "lastName": "Client"
}
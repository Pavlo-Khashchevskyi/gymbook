@token = 6f86d83e-63f6-4771-85cc-5c34143056df

### valid invite
POST http://localhost:3000/api/auth/register
Content-Type: application/json

{
  "token": "4a79c565-1332-43d0-a038-1c0abf9d7e92",
  "email": "pablo@example.com",
  "password": "password123",
  "firstName": "Pablo",
  "lastName": "Test"
}

### invalid invite
POST http://localhost:3000/api/auth/register
Content-Type: application/json

{
  "token": "00000000-0000-4000-8000-000000000000",
  "email": "pablo@example.com",
  "password": "password123",
  "firstName": "Pablo",
  "lastName": "Test"
}

